# Copy to `.env` and set your real connection string.
#
# Example (NEON/Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

GROQ_API_KEY=

# Required for OCR on scanned PDFs (e.g. University of Mumbai grade cards).
# Install Poppler: https://github.com/oschwartz10612/poppler-windows/releases
# Extract and set the path to the `bin` folder, e.g.:
# POPPLER_PATH=C:/poppler/Library/bin
# On Linux/Mac poppler is usually on PATH and this can be left blank.
POPPLER_PATH=

# Optional — improves resource quality significantly:
# GitHub token (free): github.com/settings/tokens → Generate new (classic) → public_repo read only
# Raises GitHub API rate limit from 10 to 30 req/min
GITHUB_TOKEN=

# Optional — enables real YouTube video results instead of search URL fallback:
# console.cloud.google.com → Enable "YouTube Data API v3" → Create API Key
# Free tier: 10,000 units/day (~100 searches)
YOUTUBE_API_KEY=

# Production Configuration
# Environment: development, staging, production
ENVIRONMENT=development

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (used for redirects, emails, etc.)
FRONTEND_URL=http://localhost:5173

# JWT Secret Key (generate with: openssl rand -hex 32)
# CRITICAL: Change this in production!
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.doc,.docx

# Logging Configuration
LOG_LEVEL=INFO
